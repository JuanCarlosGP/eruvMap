# Token público de Mapbox (https://account.mapbox.com/access-tokens/)
# Necesario para el mapa y la búsqueda por geocoding.
VITE_MAPBOX_TOKEN=

# Ruta base de la app (Vite `base`). En GitHub Pages: /eruvMap/
# En desarrollo local puedes usar / para abrir http://localhost:5173/
VITE_BASE_PATH=/eruvMap/
